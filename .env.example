# ---------------------------------------------------------------------------
# Work Console backend — paste this into Dokploy's Environment tab.
#
# Defaults keep every byte on your own machine: speech-to-text and the LLM both
# run in your own containers. Nothing is sent to a third party.
#
# docker-compose.yml already sets WC_DATABASE_URL, WC_OLLAMA_URL and
# WC_STORAGE_PATH from the values below, so you do not set those here.
# ---------------------------------------------------------------------------

# --- Required --------------------------------------------------------------
# The macOS app sends this as "Authorization: Bearer <token>".
# Put the same value in the app: Settings > VPS > API KEY.
WC_API_TOKEN=

# Postgres credentials. compose interpolates these into the connection string.
POSTGRES_USER=workconsole
POSTGRES_PASSWORD=
POSTGRES_DB=workconsole

# --- Speech to text (runs in your container) -------------------------------
WC_TRANSCRIPTION_PROVIDER=faster_whisper
# tiny.en ~75 MB | base.en ~145 MB | small.en ~480 MB | medium.en ~1.5 GB
# tiny.en handles clear speech. Go up if words are being missed.
WC_WHISPER_MODEL=tiny.en
WC_WHISPER_DEVICE=auto
# int8 on CPU; use float16 on a GPU.
WC_WHISPER_COMPUTE_TYPE=int8
WC_WHISPER_LANGUAGE=en
WC_WHISPER_VAD_FILTER=true

# --- LLM (runs in your container) ------------------------------------------
WC_LLM_PROVIDER=ollama
# Must be pulled first: ollama pull qwen2.5:0.5b
# ~400 MB. See DEPLOY.md for the size/quality ladder.
WC_OLLAMA_MODEL=qwen2.5:0.5b
WC_LLM_TEMPERATURE=0.1
# Raise alongside the model; small models run out of context first.
WC_LLM_NUM_CTX=4096
WC_LLM_TIMEOUT=300
# Transcripts longer than this are condensed in parts before the final pass.
WC_ANALYSIS_CHUNK_CHARS=6000

# Apply database migrations when the API starts. Leave true unless you run
# several API replicas, in which case migrate as a separate step instead.
WC_RUN_MIGRATIONS=true

# --- Jobs ------------------------------------------------------------------
WC_JOB_POLL_SECONDS=2
WC_JOB_MAX_ATTEMPTS=3
# A job whose worker died is reclaimed after this many seconds.
WC_JOB_LEASE_SECONDS=1800

# --- Agent -----------------------------------------------------------------
WC_AGENT_MAX_ITERATIONS=6
WC_AGENT_CONFIRM_DESTRUCTIVE=true
WC_AGENT_ACTION_TTL_SECONDS=900

WC_LOG_LEVEL=info

# --- Optional: cloud LLM ---------------------------------------------------
# Turning this on sends transcripts and task data to Google. Off by default.
# WC_LLM_PROVIDER=gemini
# WC_GEMINI_API_KEY=
# WC_GEMINI_MODEL=gemini-2.5-flash

# --- Optional: S3 instead of a local directory -----------------------------
# WC_STORAGE_BACKEND=s3
# WC_S3_ENDPOINT=http://minio:9000
# WC_S3_BUCKET=workconsole
# WC_S3_ACCESS_KEY=
# WC_S3_SECRET_KEY=
