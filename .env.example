# ---------------------------------------------------------------------------
# Work Console backend. Defaults keep everything on this machine.
# ---------------------------------------------------------------------------

# Bearer token the macOS app sends. Generate one: openssl rand -hex 24
# Leave empty ONLY if the API is reachable solely over a private tunnel.
WC_API_TOKEN=

WC_DATABASE_URL=postgresql+asyncpg://workconsole:workconsole@postgres:5432/workconsole

# Object storage for audio. "local" is a directory; "s3" targets MinIO or similar.
WC_STORAGE_BACKEND=local
WC_STORAGE_PATH=/var/lib/workconsole/objects
# WC_S3_ENDPOINT=http://minio:9000
# WC_S3_BUCKET=workconsole
# WC_S3_ACCESS_KEY=
# WC_S3_SECRET_KEY=

# --- Speech to text (runs here, on your hardware) --------------------------
WC_TRANSCRIPTION_PROVIDER=faster_whisper
# tiny.en / base.en / small.en / medium.en / large-v3
WC_WHISPER_MODEL=base.en
WC_WHISPER_DEVICE=auto
WC_WHISPER_COMPUTE_TYPE=int8
WC_WHISPER_LANGUAGE=en

# --- LLM (runs here, on your hardware) -------------------------------------
WC_LLM_PROVIDER=ollama
WC_OLLAMA_URL=http://ollama:11434
WC_OLLAMA_MODEL=llama3.1:8b
WC_LLM_NUM_CTX=8192

# Optional cloud provider. Selecting this sends transcripts to Google.
# WC_LLM_PROVIDER=gemini
# WC_GEMINI_API_KEY=
# WC_GEMINI_MODEL=gemini-2.5-flash

# --- Jobs ------------------------------------------------------------------
WC_JOB_POLL_SECONDS=2
WC_JOB_MAX_ATTEMPTS=3
WC_JOB_LEASE_SECONDS=1800

WC_LOG_LEVEL=info
